---
# Front matter is what makes Jekyll render this file rather than copy it.
# It MUST stay, even though it is empty apart from this comment.
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<!--
  GENERATED — do not hand-edit.

  Was a hand-written static list (2026-09-01). Converted to a template the same
  week because a hand-maintained sitemap is a guaranteed future bug: every new
  guide would need remembering, and the one that gets forgotten is invisible to
  search with no error anywhere to notice.

  Static pages are listed explicitly with real lastmod dates (they change rarely
  and their git dates are meaningful). Guides come from the collection, so a new
  article appears here automatically the moment it is committed.

  checkout-complete.html is deliberately absent: it carries its own
  <meta name="robots" content="noindex"> and is useless in search results. It is
  left OUT of the sitemap rather than Disallow'd in robots.txt, so a crawler that
  does reach it can still read that directive.

  priority/changefreq omitted throughout: Google has stated it ignores both.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://navisualguide.com/</loc>
    <lastmod>2026-08-09</lastmod>
  </url>
  <url>
    <loc>https://navisualguide.com/docs.html</loc>
    <lastmod>2026-08-02</lastmod>
  </url>
  <url>
    <loc>https://navisualguide.com/privacy.html</loc>
    <lastmod>2026-08-12</lastmod>
  </url>
  <url>
    <loc>https://navisualguide.com/terms.html</loc>
    <lastmod>2026-08-02</lastmod>
  </url>
{%- if site.guides.size > 0 %}
  <url>
    <loc>{{ '/guides/' | absolute_url }}</loc>
  </url>
{%- endif %}
{%- assign sorted = site.guides | sort: 'date' | reverse -%}
{%- for g in sorted %}
  <url>
    <loc>{{ g.url | absolute_url }}</loc>
    <lastmod>{{ g.last_modified | default: g.date | date: '%Y-%m-%d' }}</lastmod>
  </url>
{%- endfor %}
</urlset>
